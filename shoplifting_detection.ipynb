      "cell_type": "code",
      "source": [
        "# ================== INSTALL ULTRALYTICS ==================\n",
        "#!pip install opencv-python-headless==4.8.1.78\n",
        "\n",
        "# ================== IMPORTS ==================\n",
        "from ultralytics import YOLO\n",
        "import cv2\n",
        "\n",
        "# ================== LOAD MODEL ==================\n",
        "# 🔹 Replace with your trained YOLOv11 .pt file\n",
        "model = YOLO(\"/content/runs/detect/train/weights/best.pt\")\n",
        "\n",
        "# Classes from your dataset\n",
        "#CLASSES = [\"normal\", \"shoplifting\"]\n",
        "CLASSES = [\"Customer-Bagpack\",\n",
        "\"Product-Picked\",\n",
        "\"Regular\",\n",
        "\"Shoplifting\"\n",
        "\"Suspect\"]\n",
        "# ================== PROCESS VIDEO ==================\n",
        "def process_video(video_in, video_out):\n",
        "    cap = cv2.VideoCapture(video_in)\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "    w, h = int(cap.get(3)), int(cap.get(4))\n",
        "    out = cv2.VideoWriter(video_out, cv2.VideoWriter_fourcc(*'mp4v'), fps, (w, h))\n",
        "\n",
        "    while True:\n",
        "        ret, frame = cap.read()\n",
        "        if not ret:\n",
        "            break\n",
        "\n",
        "        # Run YOLO + ByteTrack\n",
        "        results = model.track(\n",
        "            frame,\n",
        "            conf=0.7,\n",
        "            persist=True,\n",
        "            tracker=\"bytetrack.yaml\",\n",
        "            verbose=False\n",
        "        )[0]\n",
        "\n",
        "        # Annotated frame from YOLO\n",
        "        annotated = results.plot()\n",
        "\n",
        "        # Loop through detections\n",
        "        for box in results.boxes:\n",
        "            cls_id = int(box.cls[0])\n",
        "            cls_name = CLASSES[cls_id]\n",
        "\n",
        "            # Draw custom alert if shoplifting detected\n",
        "            if cls_name == \"Shoplifting\":\n",
        "                x1, y1, x2, y2 = map(int, box.xyxy[0])\n",
        "                cv2.putText(\n",
        "                    annotated,\n",
        "                    \"🚨 SHOPLIFT ALERT!\",\n",
        "                    (x1, y1 - 10),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                    0.8,\n",
        "                    (0, 0, 255),\n",
        "                    2\n",
        "                )\n",
        "\n",
        "        out.write(annotated)\n",
        "\n",
        "    cap.release()\n",
        "    out.release()\n",
        "    print(f\"✅ Saved output to {video_out}\")\n",
        "\n",
        "# ================== RUN ON VIDEO ==================\n",
        "# 🔹 Replace with your video path\n",
        "process_video(\"/content/no_shoplift_video_3.mp4\", \"/content/no_shoplifting_out_test_11.mp4\")"
      ],
